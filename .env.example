# Worker (server side). Copy to .env and fill in; never commit .env.
# Clustering worker: role goyellow_worker (anonymous location data only).
WORKER_DATABASE_URL=postgresql://goyellow_worker:CHANGE_ME@HOST:5432/postgres
# Optional: alerts + weekly summaries, role goyellow_dispatch (reads follows/reports, never riders or location).
DISPATCH_DATABASE_URL=postgresql://goyellow_dispatch:CHANGE_ME@HOST:5432/postgres
# Optional: weekly AI reports (the key stays on the server, never in the app).
ANTHROPIC_API_KEY=
# Optional: push alerts through Apple (needs a paid Apple Developer account).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.example.gonc
APNS_KEY_FILE=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_SANDBOX=1
#
# The iPhone app reads GONC_SUPABASE_URL and GONC_SUPABASE_ANON_KEY from its Info.plist (see Apps/iOS/README.md).
