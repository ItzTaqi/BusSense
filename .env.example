# Copy to .env (never commit .env). Values come from your Supabase project settings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Worker only. Use the goyellow_worker role connection string, NOT the service key.
WORKER_DATABASE_URL=postgresql://goyellow_worker:CHANGE_ME@HOST:5432/postgres
